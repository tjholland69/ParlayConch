# Railway Environment Variables Reference
# Set these in your Railway project dashboard under "Variables"
#
# DATABASE_URL and REDIS_URL are auto-injected by Railway when you add
# the PostgreSQL and Redis plugins to your project — don't set them manually.

# ── Auto-provided by Railway plugins ─────────────────────────────────────────
# DATABASE_URL=postgresql://...   (set automatically by Railway Postgres plugin)
# REDIS_URL=redis://...           (set automatically by Railway Redis plugin)

# ── Required ──────────────────────────────────────────────────────────────────
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-string

# ── API Keys (copy from your Replit secrets) ──────────────────────────────────
ODDS_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── Optional / Tuning ─────────────────────────────────────────────────────────

# Set to true if Railway Postgres requires SSL (usually not needed on private network)
# PG_SSL=true
# PG_SSL_REJECT_UNAUTHORIZED=false

# Set to 1 if your Redis add-on uses TLS (rediss:// URLs)
# REDIS_TLS=1

# Postgres connection pool tuning
# PG_POOL_MAX=20
# PG_POOL_IDLE_MS=30000
# PG_POOL_CONNECT_TIMEOUT_MS=10000

# Enable the manual DB migration API endpoint (POST /api/admin/run-migration)
# PROD_MIGRATION_ENABLED=true

# Use BullMQ queue for odds sync (requires Redis)
# USE_ODDS_SYNC_QUEUE=true

# Custom OpenAI-compatible base URL (leave unset to use api.openai.com)
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Do NOT set these on Railway (Replit-only) ─────────────────────────────────
# REPL_ID
# REPL_IDENTITY
# REPLIT_CONNECTORS_HOSTNAME
# WEB_REPL_RENEWAL
# ISSUER_URL
